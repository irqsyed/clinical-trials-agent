# ClinicalTrials.gov Query-to-Visualization API — Environment Variables

# Required
# OPENAI_API_KEY= enter your key
# OpenAI Model — choose from allowed models
# Options: gpt-4o-mini, gpt-4o-2024-08-06, gpt-4.1-nano, gpt-4.1-mini, gpt-4.1
OPENAI_MODEL=gpt-4o-mini

# Server port
PORT=3000

# Max studies to fetch per query (increase for richer network graphs)
CT_PAGE_SIZE=200
