# ClinicalTrials.gov Query-to-Visualization API — Environment Variables

# Required: Your OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model — choose from allowed models:
# gpt-4o-mini, gpt-4o-2024-08-06, gpt-4.1-nano, gpt-4.1-mini, gpt-4.1, gpt-5-mini, gpt-5
OPENAI_MODEL=gpt-4o-mini

# Server port
PORT=3000

# Max studies to fetch per query (increase for richer network graphs)
CT_PAGE_SIZE=200
